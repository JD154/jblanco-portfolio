---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { AboutMeSection } from '@/components/sections/AboutMeSection';
import { ExperienceSection } from '@/components/sections/ExperienceSection';
import { ContactSectionIsland } from '@/components/islands/ContactSectionIsland';
import { CustomCursorIsland } from '@/components/islands/CustomCursorIsland';
import HeaderSection from '@/components/sections/HeaderSection/index.astro';
import { NavigationBarIsland } from '@/components/islands/NavigationBarIsland';
import { ProjectsSectionIsland } from '@/components/islands/ProjectsSectionIsland';
import { StarsBackgroundIsland } from '@/components/islands/StarsBackgroundIsland';
import { getProjectEntries } from '@/i18n/projects';
import { ui } from '@/i18n/ui';

const lang = 'es';
const t = ui[lang];
---

<BaseLayout {lang} {t}>
  <StarsBackgroundIsland client:media="(min-width: 768px)" />
  <NavigationBarIsland client:load {lang} t={t.nav} alternateUrl="/" />
  <HeaderSection t={t.header} />
  <AboutMeSection client:load t={t.about} />
  <ProjectsSectionIsland client:load projects={getProjectEntries(lang)} t={t.projects} />
  <ExperienceSection client:load t={t.experience} />
  <ContactSectionIsland client:load t={t.contact} />
  <CustomCursorIsland client:load />
</BaseLayout>
