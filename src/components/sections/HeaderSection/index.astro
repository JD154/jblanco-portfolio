---
import { AnimatedHeading } from '@/components/general/AnimatedHeading';
import { GlowingEffectIsland } from '@/components/islands/GlowingEffectIsland';
import type { Ui } from '@/i18n/ui';
import '@/components/general/GlowingButton/styles.css';
import './styles.css';

interface Props {
  t: Ui['header'];
}

const { t } = Astro.props;

const buttonBase =
  'inline-flex h-11 items-center justify-center gap-2 whitespace-nowrap rounded-md px-5 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background';
---

<div class="header-section" id="header-section-wrapper">
  <div id="header-section" class="header-section__container">
    <div class="header-section__content">
      <p class="header-section__availability">
        <span class="header-section__availability-dot" aria-hidden="true"></span>
        {t.availability}
      </p>

      <div class="header-section__signature" aria-hidden="true">
        <AnimatedHeading
          client:load
          as="div"
          text={t.signature}
          fontSize="clamp(2rem, 5vw, 3.25rem)"
          sensitivity={0.03}
          className="header-section__signature-mark"
        />
      </div>

      <h1 class="header-section__pitch">{t.role}</h1>

      <p class="header-section__tagline">{t.tagline}</p>

      {/* Temporarily hidden while the hero focuses on the primary message. */}
      {/* <ul class="header-section__capabilities">
        {t.capabilities.map((cap) => <li class="header-section__capability">{cap}</li>)}
      </ul> */}

      <div id="header-actions" class="header-section__actions">
        <a
          class:list={[
            buttonBase,
            'glowing-button relative z-10 bg-primary text-primary-foreground hover:bg-primary/90 header-section__primary-btn',
          ]}
          href="/Jesus-Blanco-Senior-Frontend-Developer.pdf"
          target="_blank"
          rel="noopener noreferrer"
        >
          <GlowingEffectIsland client:load spread={40} glow={true} disabled={false} proximity={54} />
          <svg class="header-section__action-icon" aria-hidden="true" viewBox="0 0 16 16">
            <path d="M8 2v8m0 0 3-3m-3 3L5 7M3 13h10" />
          </svg>
          <span class="luminosity-text">{t.ctaCv}</span>
        </a>
        <a
          id="view-work-cta"
          class:list={[
            buttonBase,
            'glowing-button glowing-button__outline relative z-10 border border-input bg-background hover:bg-accent hover:text-accent-foreground header-section__secondary-btn',
          ]}
          href="#projects-section"
        >
          <GlowingEffectIsland client:load spread={40} glow={true} disabled={false} proximity={54} />
          <span class="luminosity-text">{t.ctaWork}</span>
          <svg class="header-section__action-icon" aria-hidden="true" viewBox="0 0 16 16">
            <path d="M8 3v9m0 0 3.5-3.5M8 12 4.5 8.5" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  // "View selected work" → projects section. A bare hash anchor locks its target
  // offset at click time, but content above the section can still shift while the
  // smooth scroll is in flight (late web-font swap, image decode, GSAP
  // ScrollTrigger refresh), leaving the scroll short — it lands, then drifts back
  // up. So we drive the scroll ourselves and re-assert the target as it settles.
  const cta = document.getElementById('view-work-cta');

  // Land on the section's header (not its padded border-box top, which leaves a
  // ~128px dead band) with a small, deliberate breathing gap above it.
  const LANDING_GAP = 48;

  // How far (px) the page must still scroll for the header to sit just below the
  // top. 0 once settled; null when there's no target.
  const scrollGap = () => {
    const sec = document.getElementById('projects-section');
    if (!sec) return null;
    const anchor = sec.querySelector('.section-toolbar') || sec;
    return anchor.getBoundingClientRect().top - LANDING_GAP;
  };

  cta?.addEventListener('click', (event) => {
    const gap = scrollGap();
    if (gap === null) return; // no target → let the href fall through
    event.preventDefault();

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const behavior = reduce ? 'auto' : 'smooth';

    window.scrollTo({ top: window.scrollY + gap, behavior });
    history.replaceState(null, '', '#projects-section');

    if (reduce) return;

    // After the glide would have arrived, snap out any residual drift a few times
    // (late web-font swap, image decode, GSAP ScrollTrigger refresh).
    window.setTimeout(() => {
      let ticks = 0;
      const settle = window.setInterval(() => {
        const delta = Math.round(scrollGap() ?? 0);
        if (Math.abs(delta) > 4) window.scrollBy(0, delta);
        if (++ticks >= 6) window.clearInterval(settle);
      }, 180);
    }, 620);
  });
</script>
